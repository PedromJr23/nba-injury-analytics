    create  table
      "nba_injuries"."main_silver"."stg_player_tracking__dbt_tmp"
  
    
    as (
      ﻿WITH raw_tracking AS (
    SELECT
        game_id,
        player_id,
        player_name,
        game_date,
        season,
        distance_miles,
        avg_speed_mph,
        fast_break_points,
        touches
    FROM "nba_injuries"."bronze"."raw_player_tracking"
)

SELECT
    game_id,
    player_id,
    player_name,
    game_date,
    season,
    distance_miles,
    avg_speed_mph,
    
    -- Estimativa de Carga Mecânica (Distância x Velocidade Médio)
    ROUND(distance_miles * avg_speed_mph, 2) AS mechanical_workload_score,
    fast_break_points,
    touches
FROM raw_tracking
    );
    
  
[0m19:15:35.041461 [debug] [Thread-3 (]: On model.nba_injury_analytics.stg_player_workload: /* {"app": "dbt", "dbt_version": "1.9.10", "profile_name": "nba_injury_analytics", "target_name": "dev", "node_id": "model.nba_injury_analytics.stg_player_workload"} */

    

    create  table
      "nba_injuries"."main_silver"."stg_player_workload__dbt_tmp"
  
    
    as (
      ﻿WITH base_game_logs AS (
    SELECT
        game_id,
        player_id,
        player_name,
        game_date,
        season,
        team,
        opponent,
        is_home,
        minutes_played,
        pace,
        fg3a
    FROM "nba_injuries"."bronze"."raw_game_logs"
)

SELECT
    game_id,
    player_id,
    player_name,
    game_date,
    season,
    team,
    opponent,
    is_home,
    minutes_played,
    pace,
    fg3a,
    
    -- Carga Aguda: Minutos jogados nos últimos 7 dias
    SUM(minutes_played) OVER (
        PARTITION BY player_id 
        ORDER BY game_date 
        RANGE BETWEEN INTERVAL '6 DAYS' PRECEDING AND CURRENT ROW
    ) AS acute_load_minutes_7d,
    
    -- Carga Crônica: Média móvel de minutos nos últimos 28 dias
    AVG(minutes_played) OVER (
        PARTITION BY player_id 
        ORDER BY game_date 
        RANGE BETWEEN INTERVAL '27 DAYS' PRECEDING AND CURRENT ROW
    ) * 4 AS chronic_load_minutes_28d,
    
    -- Flag de Back-to-Back (jogo em dias consecutivos)
    CASE 
        WHEN LAG(game_date, 1) OVER (PARTITION BY player_id ORDER BY game_date) = game_date - INTERVAL '1 DAY'
        THEN 1 ELSE 0 
    END AS is_back_to_back
FROM base_game_logs
    );
    
  
